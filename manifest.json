{
  "manifest_version": 3,
  "name": "Tab Toolkit: Screenshots, Auto-Refresh, PII Blur, Nuke & More",
  "version": "2.10.0",
  "description": "Page tools in one popup: screenshots, privacy blur, hard refresh, site-data nuke, auto-refresh, URL shortener, volume, keep awake.",
  "permissions": [
    "alarms",
    "browsingData",
    "clipboardWrite",
    "contextMenus",
    "cookies",
    "downloads",
    "notifications",
    "offscreen",
    "power",
    "scripting",
    "sidePanel",
    "storage",
    "tabCapture",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "settings.html",
  "short_name": "Tab Toolkit",
  "side_panel": {
    "default_path": "popup.html"
  }
}
