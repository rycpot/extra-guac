{
  "manifest_version": 3,
  "name": "Hard Refresh & Nuke",
  "version": "1.0.0",
  "description": "Click: hard refresh. Right-click → Nuke: wipe all data for this site (except passwords) and reload.",
  "permissions": ["browsingData", "contextMenus", "cookies", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Hard refresh (right-click for Nuke)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
